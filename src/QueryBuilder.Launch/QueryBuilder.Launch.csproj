<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>QueryBuilder.Launch</PackageId>
    <Version>1.0.0</Version>
    <Authors>Nagendra Chinnam</Authors>
    <Description>Signs the launch token and renders the auto-submitting form that sends a user from your app to a QueryBuilder hub. No dependencies; works from .NET Framework 4.7.2+ and modern .NET.</Description>
    <PackageTags>query-builder;sso;jwt;launch</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nagendra571/QueryBuilderEditor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nagendra571/QueryBuilderEditor</PackageProjectUrl>
    <Copyright>Copyright © 2026 Nagendra Chinnam</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="QueryBuilder.Tests" />
  </ItemGroup>

</Project>
